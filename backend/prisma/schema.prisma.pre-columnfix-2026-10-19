generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  relationMode = "prisma"
  url      = env("DATABASE_URL")
}

model CalendarEvent {
  id             Int       @id @default(autoincrement())
  title          String
  notes          String?   @db.Text
  kind           String    @default("EVENT") // EVENT | DEADLINE
  allDay         Boolean   @default(false)
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  studentId      Int?
  ownerId        Int?
  remindMinutes Int?
  repeatRule     String?   // DAILY | WEEKLY | MONTHLY
  done           Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("calendarevent")
  @@index([studentId])
  @@index([ownerId])
  @@index([startsAt])
}

enum Role {
  USER
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  email String @unique
  password String
  passport String?
  address String?
  phoneNumber String?
  image String?
  role Role @default(USER)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  dossiers Dossier[]
  payments Payment[]
  receipts Receipt[]
  reviews Review[]
  contracts Contract[]
  appointments Appointment[]
  messages Message[]
  notifications Notification[]
  universityInfo UniversityInfo[]
  userAnnouncements UserAnnouncement[]
  timeSlots TimeSlot[]

}

model Appointment {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  date DateTime
  time String?
  userId Int?
  status String @default("PENDING")
  etat String @default("PRESENTIEL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dossier {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  title String
  userId Int?
  status String @default("PENDING")
  traductionStatus String @default("EN_COURS")
  inscriptionStatus String @default("EN_COURS")
  visaStatus String @default("EN_COURS")
  createdAt DateTime @default(now())
}

model StudyForm {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  email String @unique
  country String?
  program String?
  status String @default("EN_COURS")
  createdAt DateTime @default(now())
}

model Announcement {
  id Int @id @default(autoincrement())
  title String
  content String @db.Text
  type String @default("INFO")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  filePath String?
  status String @default("PENDING")
  userId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  rating Int
  comment String?
  status String @default("PENDING")
  userId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  amount Float
  status String @default("PENDING")
  userId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Receipt {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  numero String @unique
  date DateTime
  amount Float
  paymentMethod String
  userId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  user User? @relation(fields: [userId], references: [id])
  id Int @id @default(autoincrement())
  content String @db.Text
  sender String
  userId Int?
  createdAt DateTime @default(now())
}

model UniversityInfo {
  id Int @id @default(autoincrement())
  university String?
  specialty String?
  level String?
  userId Int?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@map("universityinfo")
  @@index([userId])
}

model UserAnnouncement {
  id Int @id @default(autoincrement())
  title String?
  content String? @db.Text
  userId Int?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@map("userannouncement")
  @@index([userId])
}

model Notification {
  id Int @id @default(autoincrement())
  type String?
  userId Int?
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@map("notification")
  @@index([userId])
}

model TimeSlot {
  id Int @id @default(autoincrement())
  date DateTime
  userId Int?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@map("timeslot")
  @@index([userId])
  @@index([date])
}
