generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role { USER ADMIN }
enum AppointmentStatus { PENDING CONFIRMED CANCELLED }
enum AppointmentEtat { PRESENTIEL EN_LIGNE }
enum DossierStatus { PENDING VALIDATED REJECTED }
enum DossierStage { EN_COURS VALIDE }
enum TranslationStatus { EN_COURS VALIDE }
enum InscriptionStatus { EN_COURS VALIDE }
enum VisaStatus { EN_COURS VALIDE }
enum PaymentStatus { PENDING PAID }
enum ReceiptPaymentMethod { ESPECE VIREMENT }
enum ContractStatus { PENDING UPLOADED CONFIRMED REJECTED }
enum AnnouncementType { INFO SUCCESS WARNING URGENT }
enum ReviewStatus { PENDING APPROVED REJECTED }

model User {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  email String @unique
  password String
  passport String?
  address String?
  phoneNumber String?
  image String?
  role Role @default(USER)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  appointments Appointment[]
  dossiers Dossier[]
  payments Payment[]
  receipts Receipt[]
  messages Message[]
  notifications Notification[]
  universityInfo UniversityInfo[]
  contracts Contract[]
  userAnnouncements UserAnnouncement[]
  reviews Review[]
  studentTasks StudentTask[]
  calendarEvents CalendarEvent[]
}

model Appointment {
  id Int @id @default(autoincrement())
  date DateTime
  time String?
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status AppointmentStatus @default(PENDING)
  etat AppointmentEtat @default(PRESENTIEL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dossier {
  id Int @id @default(autoincrement())
  title String
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status DossierStatus @default(PENDING)
  stage DossierStage @default(EN_COURS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  traductionStatus TranslationStatus @default(EN_COURS)
  inscriptionStatus InscriptionStatus @default(EN_COURS)
  visaStatus VisaStatus @default(EN_COURS)
}

model Payment {
  id Int @id @default(autoincrement())
  amount Float
  status PaymentStatus @default(PENDING)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Receipt {
  id Int @id @default(autoincrement())
  numero String @unique
  date DateTime
  amount Float
  paymentMethod ReceiptPaymentMethod
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id Int @id @default(autoincrement())
  rating Int
  comment String?
  status ReviewStatus @default(PENDING)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id Int @id @default(autoincrement())
  title String
  content String @db.Text
  type AnnouncementType @default(INFO)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAnnouncement {
  id Int @id @default(autoincrement())
  announcementId Int
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  read Boolean @default(false)
  createdAt DateTime @default(now())
}

model Contract {
  id Int @id @default(autoincrement())
  filePath String?
  status ContractStatus @default(PENDING)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UniversityInfo {
  id Int @id @default(autoincrement())
  university String
  specialty String?
  level String?
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String @default("APPLIED")
  city String?
  language String?
  appliedAt DateTime?
  decidedAt DateTime?
  isFinalChoice Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UniversityProgram {
  id Int @id @default(autoincrement())
  name String
  university String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyForm {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  email String @unique
  country String
  program String
  status String @default("EN_COURS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id Int @id @default(autoincrement())
  content String @db.Text
  sender String // ADMIN | USER
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id Int @id @default(autoincrement())
  type String
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  read Boolean @default(false)
  createdAt DateTime @default(now())
}

model DocumentFolder {
  id Int @id @default(autoincrement())
  dossierId Int
  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  name String
  status String @default("INCOMPLETE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentTask {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossierId Int?
  dossier Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  type String @default("GENERAL") // PAYMENTS | DOCUMENTS | UNIVERSITIES | GENERAL
  title String
  description String? @db.Text
  amount Float?
  currency String @default("TND")
  folder String?
  status String @default("OPEN") // OPEN | DONE
  assignedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id Int @id @default(autoincrement())
  date DateTime
  time String
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id Int @id @default(autoincrement())
  title String
  notes String? @db.Text
  kind String @default("EVENT")
  allDay Boolean @default(false)
  startsAt DateTime
  endsAt DateTime?
  location String?
  studentId Int?
  ownerId Int?
  remindMinutes Int?
  repeatRule String?
  done Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("calendarevent")
  @@index([studentId])
  @@index([ownerId])
  @@index([startsAt])
}

model AdmissionWindow {
  id Int @id @default(autoincrement())
  universityProgramId Int
  universityProgram UniversityProgram @relation(fields: [universityProgramId], references: [id], onDelete: Cascade)
  label String?
  callNumber Int?
  placesType String?
  openingDate DateTime?
  closingDate DateTime?
  applicationFee String?
  sourceName String
  sourceUrl String @db.Text
  openingEvidence Json?
  closingEvidence Json?
  feeEvidence Json?
  verificationStatus String @default("NEEDS_REVIEW")
  confidence Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
