generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model AgentOffice {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "agentoffice_name_unique") @db.VarChar(120)
  city      String?  @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("agentoffice")
}

model AgencySetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique(map: "agencysetting_key_unique") @db.VarChar(100)
  settingValue String   @db.VarChar(255)
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("agencysetting")
}

model StudentTask {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id])
  dossierId   Int?
  type        studenttask_type   @default(GENERAL)
  title       String
  description String?            @db.LongText
  amount      Decimal?           @db.Decimal(10, 2)
  currency    String?            @default("TND")
  folder      String?
  status      studenttask_status @default(OPEN)
  assignedAt  DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId], map: "StudentTask_userId_fkey")
  @@index([userId], map: "StudentTask_userId_idx")
  @@map("studenttask")
}

model StudentInvite {
  id          Int       @id @default(autoincrement())
  token       String    @unique(map: "studentinvite_token_unique") @db.VarChar(100)
  email       String?
  usedAt      DateTime?
  userId      Int?
  expiresAt   DateTime
  createdById Int?
  createdAt   DateTime  @default(now())

  @@map("studentinvite")
}

model CalendarEvent {
  id            Int       @id @default(autoincrement())
  kind          String    @default("EVENT") @db.VarChar(20)
  title         String
  notes         String?   @db.Text
  allDay        Boolean   @default(false)
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  studentId     Int?
  ownerId       Int?
  remindMinutes Int?
  repeatRule    String?   @db.VarChar(20)
  done          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([startsAt])
  @@map("calendarevent")
}

model UniversityInfo {
  id              Int                   @id @default(autoincrement())
  university      String
  specialty       String
  level           String
  userId          Int
  user            User                  @relation(fields: [userId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime
  status          universityinfo_status @default(APPLIED)
  city            String?
  language        String?
  appliedAt       DateTime?
  decidedAt       DateTime?
  isFinalChoice   Boolean               @default(false)
  offerDocumentId Int?

  @@index([userId], map: "UniversityInfo_userId_fkey")
  @@map("universityinfo")
}

model UserAnnouncement {
  id             Int      @id @default(autoincrement())
  userId         Int
  announcementId Int
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, announcementId], map: "UserAnnouncement_userId_announcementId_key")
  @@index([announcementId], map: "UserAnnouncement_announcementId_fkey")
  @@map("userannouncement")
}

model Notification {
  id        Int      @id @default(autoincrement())
  content   String
  isRead    Boolean  @default(false)
  userId    Int
  createdAt DateTime @default(now())

  @@index([userId], map: "Notification_userId_fkey")
  @@map("notification")
}

model TimeSlot {
  id              Int      @id @default(autoincrement())
  date            DateTime
  startTime       String
  endTime         String
  maxBookings     Int      @default(1)
  currentBookings Int      @default(0)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@map("timeslot")
}

model Document {
  id            Int       @id @default(autoincrement())
  dossierId     Int
  filePath      String
  fileName      String
  category      String
  name          String
  size          Int?
  mimeType      String?
  uploaderId    Int?
  uploaderRole  String?
  status        String    @default("PENDING")
  isTranslation Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submittedAt   DateTime?

  @@index([dossierId], map: "Document_dossierId_fkey")
  @@map("document")
}

model admissionwindow {
  id                  Int       @id @default(autoincrement())
  universityProgramId Int
  label               String?
  callNumber          Int?
  placesType          String?
  openingDate         DateTime?
  closingDate         DateTime?
  applicationFee      String?
  sourceName          String
  sourceUrl           String    @db.Text
  openingEvidence     String?   @db.LongText
  closingEvidence     String?   @db.LongText
  feeEvidence         String?   @db.LongText
  verificationStatus  String    @default("NEEDS_REVIEW")
  confidence          Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([closingDate], map: "AdmissionWindow_closingDate_idx")
  @@index([openingDate], map: "AdmissionWindow_openingDate_idx")
  @@index([universityProgramId], map: "AdmissionWindow_universityProgramId_idx")
  @@index([verificationStatus], map: "AdmissionWindow_verificationStatus_idx")
}

model announcement {
  id        Int               @id @default(autoincrement())
  title     String
  content   String
  type      announcement_type @default(INFO)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime
  link      String?
}

model appointment {
  id        Int                @id @default(autoincrement())
  type      String
  date      DateTime
  status    appointment_status @default(PENDING)
  userId    Int
  user      User               @relation(fields: [userId], references: [id])
  createdAt DateTime           @default(now())
  etat      appointment_etat   @default(PRESENTIEL)
  slotId    Int?
  time      String?            @db.VarChar(255)

  @@index([userId], map: "Appointment_userId_fkey")
}

model contract {
  id        Int             @id @default(autoincrement())
  fileName  String
  filePath  String
  status    contract_status @default(PENDING)
  userId    Int
  createdAt DateTime        @default(now())
  updatedAt DateTime

  @@index([userId], map: "Contract_userId_fkey")
}

model documentfolder {
  id        Int      @id @default(autoincrement())
  dossierId Int
  name      String
  status    String   @default("INCOMPLETE")
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([dossierId], map: "DocumentFolder_dossierId_fkey")
}

model dossier {
  id                Int                       @id @default(autoincrement())
  title             String
  status            dossier_status            @default(PENDING)
  userId            Int
  user              User                      @relation(fields: [userId], references: [id])
  createdAt         DateTime                  @default(now())
  inscriptionStatus dossier_inscriptionStatus @default(EN_COURS)
  traductionStatus  dossier_traductionStatus  @default(EN_COURS)
  visaStatus        dossier_visaStatus        @default(EN_COURS)
  agreedFee         Decimal?                  @db.Decimal(10, 2)
  officeId          Int?

  @@index([userId], map: "Dossier_userId_fkey")
}

model message {
  id        Int       @id @default(autoincrement())
  content   String
  sender    String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  fileName  String?
  filePath  String?
  fileSize  Int?
  fileType  String?
  readAt    DateTime?

  @@index([userId], map: "Message_userId_fkey")
}

model payment {
  id        Int            @id @default(autoincrement())
  amount    Float
  status    payment_status @default(PENDING)
  userId    Int
  createdAt DateTime       @default(now())
  prixPaye  Float          @default(0)
  prixReste Float
  prixTotal Float
  method    String?
  loggedBy  String?
  paidAt    DateTime?
  updatedAt DateTime?      @default(now()) @db.DateTime(0)

  receipts receipt[]

  @@index([userId], map: "Payment_userId_fkey")
}

model receipt {
  id            Int                   @id @default(autoincrement())
  receiptNumber String                @unique(map: "Receipt_receiptNumber_key")
  amount        Float
  paymentMethod receipt_paymentMethod
  paymentDate   DateTime
  userId        Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId     Int?
  payment       payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([paymentDate], map: "Receipt_paymentDate_idx")
  @@index([userId], map: "Receipt_userId_idx")
  @@index([paymentId], map: "Receipt_paymentId_idx")
}

model review {
  id         Int           @id @default(autoincrement())
  rating     Int
  content    String        @db.Text
  status     review_status @default(PENDING)
  adminNote  String?       @db.Text
  reviewedAt DateTime?
  userId     Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([createdAt], map: "Review_createdAt_idx")
  @@index([status], map: "Review_status_idx")
  @@index([userId], map: "Review_userId_idx")
}

model study_in_italy_forms {
  id               Int      @id @default(autoincrement())
  fullName         String
  phoneNumber      String
  email            String
  city             String
  passportStatus   String
  currentLevel     String
  desiredLevel     String
  studyLanguage    String
  desiredSpecialty String
  age              Int
  selectedPack     String
  submissionDate   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model studyform {
  id        Int       @id @default(autoincrement())
  firstName String?   @db.VarChar(255)
  lastName  String?   @db.VarChar(255)
  email     String?   @unique(map: "email") @db.VarChar(255)
  country   String?   @db.VarChar(255)
  program   String?   @db.VarChar(255)
  status    String?   @default("EN_COURS") @db.VarChar(255)
  createdAt DateTime? @default(now()) @db.DateTime(0)
}

model universityprogram {
  id                 Int       @id @default(autoincrement())
  university         String
  city               String?
  programName        String
  level              String?
  language           String?
  field              String
  openingDate        DateTime?
  closingDate        DateTime?
  applicationFee     String?
  tuition            String?
  sourceName         String
  sourceUrl          String    @db.Text
  lastVerifiedAt     DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  closingEvidence    String?   @db.LongText
  confidence         Float?
  feeEvidence        String?   @db.LongText
  openingEvidence    String?   @db.LongText
  verificationStatus String    @default("NEEDS_REVIEW")
  tuitionEvidence    String?   @db.LongText

  @@index([closingDate], map: "UniversityProgram_closingDate_idx")
  @@index([field], map: "UniversityProgram_field_idx")
  @@index([lastVerifiedAt], map: "UniversityProgram_lastVerifiedAt_idx")
  @@index([university], map: "UniversityProgram_university_idx")
  @@index([verificationStatus], map: "UniversityProgram_verificationStatus_idx")
}

model User {
  id              Int           @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String        @unique(map: "User_email_key")
  password        String
  passport        String
  role            user_role     @default(USER)
  createdAt       DateTime      @default(now())
  address         String
  image           String?       @db.Text
  phoneNumber     String
  isApproved      Boolean       @default(false)
  officeId        Int?
  isAgent         Boolean       @default(false)
  allowedSections String?       @db.VarChar(500)
  studentTasks    StudentTask[]

  universityInfos UniversityInfo[]
  appointments    appointment[]
  dossiers        dossier[]
  messages        message[]
  receipts       receipt[]
  folderAccesses FolderAccess[] @relation("FolderAccess_user")
}

enum dossier_status {
  PENDING
  VALIDATED
  REJECTED
}

enum payment_status {
  PENDING
  PAID
}

enum announcement_type {
  INFO
  SUCCESS
  WARNING
  URGENT
}

enum appointment_status {
  PENDING
  CONFIRMED
  CANCELLED
}

enum contract_status {
  PENDING
  UPLOADED
  CONFIRMED
  REJECTED
}

enum receipt_paymentMethod {
  ESPECE
  VIREMENT
}

enum review_status {
  PENDING
  APPROVED
  REJECTED
}

enum studenttask_type {
  PAYMENTS
  DOCUMENTS
  UNIVERSITIES
  GENERAL
}

enum dossier_inscriptionStatus {
  EN_COURS
  VALIDE
}

enum appointment_etat {
  PRESENTIEL
  EN_LIGNE
}

enum dossier_traductionStatus {
  EN_COURS
  VALIDE
}

enum user_role {
  USER
  ADMIN
  AGENT
}

enum dossier_visaStatus {
  EN_COURS
  VALIDE
}

enum universityinfo_status {
  AWAITING_PAYMENT
  APPLIED
  ACCEPTED
  REJECTED
}

enum studenttask_status {
  OPEN
  DONE
}

model FolderAccess {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], name: "FolderAccess_user")
  folder       String
  allowed      Boolean  @default(false)
  updatedById  Int?
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([userId, folder])
  @@index([userId], map: "FolderAccess_userId_idx")
  @@index([folder], map: "FolderAccess_folder_idx")
  @@map("folderaccess")
}
